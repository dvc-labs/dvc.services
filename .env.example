# Secret: set this in the host's encrypted environment settings.
DISCORD_TOKEN=

# IDs are strings. Do not add spaces or turn them into JavaScript numbers.
# Replace each placeholder with the matching ID from your own application/server.
GUILD_ID=YOUR_GUILD_ID
APPLICATION_ID=YOUR_APPLICATION_ID
VERIFICATION_ROLE_ID=YOUR_VERIFICATION_ROLE_ID
VERIFICATION_CHANNEL_ID=YOUR_VERIFICATION_CHANNEL_ID
COMMANDS_CHANNEL_ID=YOUR_COMMANDS_CHANNEL_ID
LOGS_CHANNEL_ID=YOUR_LOGS_CHANNEL_ID

# Optional: leave empty to discover/reuse the bot's existing panel automatically.
# Set an existing panel's message ID to select it explicitly.
VERIFICATION_MESSAGE_ID=

# Optional settings (these values are also the defaults).
NODE_ENV=production
TZ=Europe/Brussels
# Also set this when a managed panel launches the main file directly.
NODE_OPTIONS=--max-old-space-size=256
PORT=8080
LOG_LEVEL=info
