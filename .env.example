# Secret: set this in the host's encrypted environment settings.
DISCORD_TOKEN=

# IDs are strings. Do not add spaces or turn them into JavaScript numbers.
# Replace each placeholder with the matching ID from your own application/server.
GUILD_ID=YOUR_GUILD_ID
APPLICATION_ID=YOUR_APPLICATION_ID
VERIFICATION_ROLE_ID=YOUR_VERIFICATION_ROLE_ID
# Optional existing staff role that already counts as server access. Never assigned by the bot.
ADMIN_ROLE_ID=
VERIFICATION_CHANNEL_ID=YOUR_VERIFICATION_CHANNEL_ID
COMMANDS_CHANNEL_ID=YOUR_COMMANDS_CHANNEL_ID
LOGS_CHANNEL_ID=YOUR_LOGS_CHANNEL_ID

# Optional: leave empty to discover/reuse the bot's existing panel automatically.
# Set an existing panel's message ID to select it explicitly.
VERIFICATION_MESSAGE_ID=

# Optional: a normal role members with access can opt into from the verification channel.
# Leave empty to disable news pings. The bot's role must sit above it.
BULLETIN_ROLE_ID=

# Cherry Creek whitelist requests need both channels and an ordinary Minecrafter role.
# Keep MOD_CHANNEL_ID private to staff and the bot.
MOD_CHANNEL_ID=
MINECRAFT_CHANNEL_ID=
MINECRAFTER_ROLE_ID=

# Keep this directory on persistent storage. Docker Compose mounts /data automatically.
# On loon.host set a persistent path outside the deployment checkout, e.g. /home/container/data.
# DATA_DIR=./data

# Optional /ask: reuse the same Hall Worker origin as CityMart Services.
# WORKER_URL=https://hall.davevancauwenberghe.be
WORKER_URL=
# Secret: must match the Worker's DISCORD_API_KEY. This is not the OpenAI or Discord token.
HALLAI_API_KEY=

# Optional application-owned branding. Unset or blank keeps the official dvc emoji.
# For a separate test app, explicitly use its own <:name:id> or disable with none.
# DVC_EMOJI=none

# Optional settings (these values are also the defaults).
NODE_ENV=production
TZ=Europe/Brussels
# Also set this when a managed panel launches the main file directly.
NODE_OPTIONS=--max-old-space-size=256
PORT=8080
LOG_LEVEL=info
